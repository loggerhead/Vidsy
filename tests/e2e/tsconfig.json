{
  "extends": "@extension/tsconfig/module",
  "compilerOptions": {
    "lib": ["dom"],
    "types": ["node", "vitest/globals", "chrome"],
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
